# Copy to .env.local and fill in ONE provider. Restart `npm run dev` after changing.

# Google Gemini image editing (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: gemini-3.1-flash-image (default), gemini-3-pro-image (higher quality), gemini-3.1-flash-lite-image (cheapest)
GEMINI_IMAGE_MODEL=

# Or fal.ai hosted open models (https://fal.ai/dashboard/keys)
FAL_KEY=
# Optional: fal-ai/flux-pro/kontext (default), fal-ai/qwen-image-edit, ...
FAL_MODEL=

# SMS sign-in codes through MSG91 (https://control.msg91.com). Without these, dev mode shows the code on screen.
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# AI finishes per signed-in user per day (default 3)
AI_DAILY_LIMIT=3

# Optional: POST each quote request here (Slack, Zapier, Make, Google Apps Script)
LEAD_WEBHOOK_URL=

# Test sign-in without SMS (demo only): codes shown on screen; a fixed code is needed on Vercel
OTP_TEST_MODE=
OTP_TEST_CODE=
