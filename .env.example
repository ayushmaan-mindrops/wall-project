# Copy to .env.local and fill in ONE provider. Restart `npm run dev` after changing.

# Google Gemini image editing (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: gemini-3.1-flash-image (default), gemini-3-pro-image (higher quality), gemini-3.1-flash-lite-image (cheapest)
GEMINI_IMAGE_MODEL=

# Or fal.ai hosted open models (https://fal.ai/dashboard/keys)
FAL_KEY=
# Optional: fal-ai/flux-pro/kontext (default), fal-ai/qwen-image-edit, ...
FAL_MODEL=
